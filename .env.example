# Copy to .env for local runs outside Docker (uv run uvicorn ctx_server.app:app --port 8080).
# In production these come from Terraform (Cloud Run env vars and Secret Manager).

CTX_ENV=dev
CTX_PUBLIC_BASE_URL=http://localhost:8080
CTX_DATABASE_URL=postgresql+asyncpg://ctx:ctx@localhost:5432/ctx
CTX_SESSION_SECRET=change-me-to-a-long-random-string
CTX_DEV_LOGIN=true

# Sign-in providers (either or both)
CTX_GOOGLE_CLIENT_ID=
CTX_GOOGLE_CLIENT_SECRET=
CTX_GITHUB_CLIENT_ID=
CTX_GITHUB_CLIENT_SECRET=

# AI providers: vertex | gemini_api | local | fake (embeddings); vertex_gemini |
# vertex_claude | gemini_api | none | fake (arbiter)
CTX_EMBEDDING_PROVIDER=fake
CTX_ARBITER_PROVIDER=fake
CTX_ARBITER_MODEL=gemini-3-flash-preview
CTX_ARBITER_LOCATION=global
CTX_GEMINI_API_KEY=
CTX_GCP_PROJECT=
CTX_VERTEX_LOCATION=us-central1

# Optional: exact Claude token counting
CTX_ANTHROPIC_API_KEY=
